<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_res_config_settings_precios" model="ir.ui.view">
        <field name="name">res.config.settings.precios.surtidora</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='pricing_setting_container']" position="inside">
                <setting id="surtidora_lista_precio_ficha_setting"
                         string="Precio de venta de la ficha"
                         help="Lo que se cobra es el precio de la LISTA. Para que el campo «Precio de venta» de la ficha no muestre un número que nadie cobra, se pone al día con la unidad base de esta lista al mantener precios. Vacío = no se toca.">
                    <field name="surtidora_lista_precio_ficha"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
