<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_margen_lista_list" model="ir.ui.view">
        <field name="name">surtidora.margen.lista.list</field>
        <field name="model">surtidora.margen.lista</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="pricelist_id"/>
                <field name="margen_pct"/>
                <field name="descuento_empaque_pct"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="action_margen_lista" model="ir.actions.act_window">
        <field name="name">Márgenes sugeridos por lista</field>
        <field name="res_model">surtidora.margen.lista</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Todavía no hay escalera definida</p>
            <p>
                Con qué margen propone «Precios y margen» el precio de un producto
                nuevo, lista por lista. Pulse <b>Calcular desde el catálogo</b> y
                se rellena con lo que la casa ya hace hoy; después se ajusta a mano.
            </p>
            <p>
                Se miran solo los productos que tienen precios DISTINTOS entre
                listas, que son los fijados con criterio. Los que tienen las cuatro
                iguales vienen así de la carga de ADG.
            </p>
        </field>
    </record>

    <record id="server_calcular_margenes" model="ir.actions.server">
        <field name="name">Calcular desde el catálogo</field>
        <field name="model_id" ref="model_surtidora_margen_lista"/>
        <field name="binding_model_id" ref="model_surtidora_margen_lista"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">model.calcular_desde_catalogo()</field>
    </record>

    <menuitem id="menu_margen_lista"
              name="Márgenes sugeridos por lista"
              parent="sale.menu_sale_config"
              action="action_margen_lista"
              groups="sales_team.group_sale_manager"
              sequence="95"/>
</odoo>
