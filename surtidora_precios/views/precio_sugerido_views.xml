<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_precio_sugerido_form" model="ir.ui.view">
        <field name="name">surtidora.precio.sugerido.form</field>
        <field name="model">surtidora.precio.sugerido</field>
        <field name="arch" type="xml">
            <form string="Precios y margen">
                <field name="aviso" invisible="not aviso" readonly="1"
                       nolabel="1" class="alert alert-warning" role="alert"/>
                <group>
                    <group>
                        <field name="product_tmpl_id" readonly="1"/>
                        <field name="costo_base" readonly="1"/>
                        <field name="itbis_pct" string="ITBIS %" readonly="1"/>
                    </group>
                    <group>
                        <field name="modo" widget="radio"/>
                        <field name="margen_objetivo" invisible="modo != 'uniforme'"/>
                        <field name="descuento_empaque" invisible="modo != 'uniforme'"/>
                        <field name="redondeo"/>
                        <button name="action_sugerir" type="object"
                                string="Sugerir desde el costo" class="btn-secondary"/>
                    </group>
                </group>
<separator string="¿Falta un empaque?"/>
                <p class="text-muted">
                    Abajo solo salen las unidades que el producto YA tiene. Si le
                    falta una —«el paquete trae 25 unidades»— decláresela aquí y
                    aparecerá en la tabla lista para ponerle precio.
                </p>
                <group>
                    <group>
                        <field name="empaque_nombre" string="Se llama"
                               placeholder="Paquete, Caja, Fardo..."/>
                        <field name="empaque_cantidad" string="Trae cuántas unidades"/>
                    </group>
                    <group>
                        <button name="action_agregar_empaque" type="object"
                                string="Agregar empaque a este producto"
                                class="btn-secondary"
                                invisible="empaque_cantidad &lt;= 1"/>
                    </group>
                </group>
                <field name="empaque_vista_previa" invisible="1"/>
                <div class="alert alert-info" role="alert"
                     invisible="not empaque_vista_previa">
                    <field name="empaque_vista_previa" nolabel="1" readonly="1"/>
                </div>
                <separator string="Precio por lista y unidad"/>
                <field name="linea_ids" nolabel="1">
                    <list editable="bottom" create="false" delete="false">
                        <field name="lista_id" readonly="1"/>
                        <field name="uom_id" readonly="1"/>
                        <field name="factor" optional="hide" readonly="1"/>
                        <field name="costo_total" readonly="1"/>
                        <field name="precio_actual" readonly="1"/>
                        <field name="margen_actual" optional="show" readonly="1"/>
                        <field name="precio_nuevo"/>
                        <field name="margen_nuevo"
                               decoration-danger="margen_nuevo &lt; 0"
                               decoration-warning="margen_nuevo &gt;= 0 and margen_nuevo &lt; 5"
                               decoration-success="margen_nuevo &gt;= 5"/>
                    </list>
                </field>
                <p class="text-muted mt-2">
                    El precio es el del empaque COMPLETO — «la caja a 880» —;
                    la conversión a unidad base la hace el sistema. El margen
                    se calcula sobre el costo con ITBIS, igual que en el
                    sistema actual, y <b>se puede teclear</b>: escriba el margen
                    y el precio sale solo, redondeado. Así se le da a Mayor un
                    margen distinto que a Detalle.
                    <br/>
                    <b>Sugerir desde el costo</b> propone toda la tabla sin que
                    haya que teclear un solo precio: la unidad sale del margen
                    sobre el costo, y cada empaque de esa unidad menos el
                    descuento por volumen — que es como se fijan los precios
                    aquí (el 96% de los empaques del catálogo está puesto así).
                    Ningún precio puede quedar por debajo del costo (RB-08).
                </p>
                <footer>
                    <button string="Aplicar" name="action_aplicar" type="object"
                            class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_precio_sugerido" model="ir.actions.act_window">
        <field name="name">Precios y margen</field>
        <field name="res_model">surtidora.precio.sugerido</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Botón en la ficha NATIVA del producto: no se reemplaza el
         formulario estándar, solo se le agrega el acceso. -->
    <record id="view_product_template_form_precios" model="ir.ui.view">
        <field name="name">product.template.form.precios.surtidora</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="%(action_precio_sugerido)d" type="action"
                        class="oe_stat_button" icon="fa-tags"
                        groups="sales_team.group_sale_manager">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Precios y</span>
                        <span class="o_stat_text">margen</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
