<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="surtidora_precios.Pantalla">
    <div class="surti-precios d-flex flex-column h-100 overflow-hidden">

        <div class="surti-pre-toolbar d-flex align-items-end gap-3 p-2 border-bottom bg-view">
            <div class="surti-pre-combo">
                <label class="d-block">Producto</label>
                <input type="text" class="o_input surti-pre-buscar"
                       placeholder="Código, nombre o barcode..."
                       autocomplete="off"
                       t-att-value="state.buscar"
                       t-on-input="escribir"
                       t-on-keydown="teclado"
                       t-on-blur="cerrarLista"/>
                <div class="surti-pre-lista" t-if="state.listaAbierta">
                    <t t-foreach="state.resultados" t-as="p" t-key="p.id">
                        <div t-att-class="'surti-pre-item' + (p_index === state.resaltado ? ' surti-pre-activo' : '')"
                             t-on-mousedown.prevent="() => this.elegir(p)">
                            <span class="surti-pre-ref" t-esc="p.ref"/>
                            <span t-esc="p.nombre"/>
                        </div>
                    </t>
                </div>
            </div>
            <button class="btn btn-primary" t-on-click="guardar"
                    t-att-disabled="!hayCambios or state.guardando">
                <t t-if="state.guardando">Guardando...</t>
                <t t-else="">Guardar cambios</t>
            </button>
            <span class="ms-auto small text-muted fst-italic">
                Precios CON ITBIS · costos del producto SIN ITBIS · margen sobre costo con ITBIS
            </span>
        </div>

        <div class="flex-grow-1 overflow-auto p-2" t-if="state.data">
            <div class="surti-pre-cabecera">
                <span class="surti-pre-titulo"><t t-esc="state.data.ref"/> — <t t-esc="state.data.nombre"/></span>
                <span class="surti-pre-dato">Costo base (sin ITBIS): <b t-esc="n(state.data.costo_base)"/></span>
                <span class="surti-pre-dato">ITBIS: <b t-esc="n(state.data.itbis_pct, 0) + '%'"/></span>
                <span class="surti-pre-extra" t-if="state.data.reglas_extra">
                    ⚠ <t t-esc="state.data.reglas_extra"/> regla(s) adicionales (variantes,
                    promociones con fecha o cantidades especiales) no se editan aquí.
                </span>
            </div>

            <div class="surti-pre-grupos">
                <div class="surti-pre-grupo" t-foreach="listasAgrupadas" t-as="grupo" t-key="grupo.lista_id">
                    <div class="surti-pre-grupo-titulo" t-esc="grupo.lista"/>
                    <table class="table table-sm mb-0">
                        <thead>
                            <tr>
                                <th>Unidad</th>
                                <th class="text-end">Costo c/ITBIS</th>
                                <th class="text-end">Precio</th>
                                <th class="text-end">Unitario</th>
                                <th class="text-end">% Margen</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="grupo.filas" t-as="fila" t-key="fila.uom_id">
                                <td t-esc="fila.unidad"/>
                                <td class="text-end text-muted" t-esc="n(fila.costo_total_itbis)"/>
                                <td class="text-end">
                                    <!-- t-on-input: el margen se recalcula POR TECLA,
                                         que es el termómetro que justifica la pantalla -->
                                    <input type="number" min="0" step="0.01"
                                           class="surti-pre-input text-end"
                                           t-att-value="precioDe(fila) || ''"
                                           t-on-input="(ev) => this.editar(fila, ev)"/>
                                </td>
                                <td class="text-end text-muted"
                                    t-esc="fila.factor > 1 ? n(precioDe(fila) / fila.factor) : ''"/>
                                <td class="text-end fw-bold" t-att-class="claseMargen(fila)">
                                    <t t-if="margenDe(fila) !== null" t-esc="n(margenDe(fila), 1) + '%'"/>
                                    <t t-else="">—</t>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="small text-muted mt-2">
                Rojo = bajo costo (RB-08, no se puede guardar) · Ámbar = bajo el piso del 5% · El precio es el total del empaque.
            </div>
        </div>

        <div class="p-5 text-center text-muted" t-elif="state.cargando">Cargando...</div>
        <div class="p-5 text-center text-muted" t-else="">
            Busque un producto para mantener sus precios por lista y empaque.
        </div>

    </div>
</t>

</templates>
