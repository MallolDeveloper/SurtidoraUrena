<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_etiqueta_57x32" model="report.paperformat">
        <field name="name">Etiqueta 57x32mm (rollo)</field>
        <field name="format">custom</field>
        <field name="page_width">57</field>
        <field name="page_height">32</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">2</field>
        <field name="margin_bottom">2</field>
        <field name="margin_left">2</field>
        <field name="margin_right">2</field>
        <field name="dpi">203</field>
    </record>

    <record id="action_report_etiquetas" model="ir.actions.report">
        <field name="name">Etiquetas de productos y empaques</field>
        <field name="model">surtidora.etiquetas.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">surtidora_etiquetas.report_etiquetas</field>
        <field name="paperformat_id" ref="paperformat_etiqueta_57x32"/>
    </record>

    <template id="report_etiquetas">
        <t t-call="web.basic_layout">
            <t t-foreach="etiquetas" t-as="e">
                <div class="page" style="page-break-after: always; font-family: sans-serif; text-align: center;">
                    <div style="font-size: 9px; font-weight: bold; height: 22px; overflow: hidden; line-height: 1.1;">
                        <t t-esc="e['nombre']"/>
                    </div>
                    <div style="font-size: 8px;">
                        <t t-esc="e['referencia']"/> · <t t-esc="e['unidad']"/>
                    </div>
                    <div style="font-size: 14px; font-weight: bold;">
                        RD$ <t t-esc="'%.2f' % e['precio']"/>
                    </div>
                    <t t-if="e['barcode']">
                        <!-- `auto`, no una simbología fija. Odoo mira el largo:
                             13 -> EAN-13, 8 -> EAN-8, cualquier otro -> Code128;
                             y si el dígito verificador no cuadra también cae a
                             Code128, que encoda el número tal cual. Así los 22
                             EAN-8 del catálogo (cigarrillos, cervezas) salen en
                             su simbología, más estrecha en 48mm, en vez de un
                             Code128 largo.

                             OJO: NO poner `UPCA` para los 706 códigos de 12
                             dígitos. Odoo convierte UPCA a EAN-13 ANTEPONIENDO
                             UN CERO (ir_actions_report.py), así que imprimiría
                             0028661704211 — trece dígitos que no existen en la
                             ficha y que al escanear no encuentran el producto.
                             Con `auto` esos 12 dígitos salen en Code128, exactos.
                             Verificado comparando las imágenes byte a byte. -->
                        <img t-att-src="'/report/barcode/?barcode_type=auto&amp;value=%s&amp;width=400&amp;height=60&amp;humanreadable=1' % e['barcode']"
                             style="width: 48mm; height: 9mm;"/>
                    </t>
                    <t t-else="">
                        <div style="font-size: 8px; color: #888;">(sin código — generar código interno)</div>
                    </t>
                </div>
            </t>
        </t>
    </template>
</odoo>
