<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_etiquetas_wizard_form" model="ir.ui.view">
        <field name="name">surtidora.etiquetas.wizard.form</field>
        <field name="model">surtidora.etiquetas.wizard</field>
        <field name="arch" type="xml">
            <form string="Imprimir etiquetas">
                <group>
                    <field name="pricelist_id"/>
                    <field name="incluir_empaques"/>
                    <field name="product_ids" widget="many2many_tags"/>
                </group>
                <footer>
                    <button name="action_imprimir" type="object" string="Imprimir" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
