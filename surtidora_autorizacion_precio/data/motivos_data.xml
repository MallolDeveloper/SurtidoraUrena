<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Precarga inicial — el listado definitivo lo entrega Surtidora Ureña
         (punto 6 de la reunión del 7-ago). Editables y archivables. -->
    <record id="motivo_vencimiento_proximo" model="surtidora.motivo.descuento">
        <field name="name">Vencimiento próximo</field>
        <field name="sequence">10</field>
    </record>
    <record id="motivo_producto_vencido" model="surtidora.motivo.descuento">
        <field name="name">Producto vencido</field>
        <field name="sequence">20</field>
    </record>
    <record id="motivo_averia" model="surtidora.motivo.descuento">
        <field name="name">Avería / empaque dañado</field>
        <field name="sequence">30</field>
    </record>
    <record id="motivo_promocion" model="surtidora.motivo.descuento">
        <field name="name">Promoción</field>
        <field name="sequence">40</field>
    </record>
    <record id="motivo_negociacion" model="surtidora.motivo.descuento">
        <field name="name">Negociación con el cliente</field>
        <field name="sequence">50</field>
    </record>
    <record id="motivo_competencia" model="surtidora.motivo.descuento">
        <field name="name">Precio de competencia</field>
        <field name="sequence">60</field>
    </record>
</odoo>
