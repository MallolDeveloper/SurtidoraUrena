<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_autorizar_precio_wizard_form" model="ir.ui.view">
        <field name="name">surtidora.autorizar.precio.wizard.form</field>
        <field name="model">surtidora.autorizar.precio.wizard</field>
        <field name="arch" type="xml">
            <form string="Autorizar precios">
                <field name="order_id" invisible="1"/>
                <field name="linea_ids" nolabel="1">
                    <list create="false" delete="false">
                        <field name="line_id" column_invisible="1"/>
                        <field name="product_id"/>
                        <field name="uom_id"/>
                        <field name="cantidad"/>
                        <!--
                            Solo lectura como MODIFICADOR DE VISTA: son
                            informativos, el supervisor no los teclea. No es
                            lo que protege el dato — el cliente descarta los
                            readonly al guardar, vengan del modelo o de aquí
                            (`_getChanges` mira `activeFields[x].readonly`, y
                            el parser del arch copia ahí el del modelo). Lo
                            que garantiza la auditoría es que
                            `action_autorizar` relee ambos del servidor.
                        -->
                        <field name="precio_lista" readonly="1"/>
                        <field name="precio_propuesto"/>
                        <field name="bajo_costo" readonly="1" decoration-danger="bajo_costo"/>
                        <field name="currency_id" column_invisible="1"/>
                    </list>
                </field>
                <group>
                    <field name="motivo_id" options="{'no_create_edit': True, 'no_quick_create': True}"/>
                    <field name="pin" password="True" required="1"/>
                    <field name="nota"/>
                </group>
                <footer>
                    <button name="action_autorizar" type="object" string="Autorizar" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
