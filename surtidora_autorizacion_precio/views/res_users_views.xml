<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_users_form_pin" model="ir.ui.view">
        <field name="name">res.users.form.pin.autorizacion</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <notebook position="inside">
                <page string="Autorización de precios" name="autorizacion_precio"
                      groups="base.group_system">
                    <group>
                        <field name="surtidora_pin" password="True"/>
                    </group>
                </page>
            </notebook>
        </field>
    </record>
</odoo>
