<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_autorizacion" model="ir.ui.view">
        <field name="name">res.company.form.autorizacion.precio</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <notebook position="inside">
                <page string="Autorización de precios" name="autorizacion_precio">
                    <group>
                        <field name="surtidora_tolerancia_precio_pct"/>
                        <field name="surtidora_permitir_bajo_costo" groups="base.group_system"/>
                    </group>
                </page>
            </notebook>
        </field>
    </record>
</odoo>
