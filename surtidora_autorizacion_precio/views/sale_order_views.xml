<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_autorizacion" model="ir.ui.view">
        <field name="name">sale.order.form.autorizacion.precio</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <field name="requiere_autorizacion_precio" invisible="1"/>
                <button name="action_abrir_autorizacion_precios" type="object"
                        string="Autorizar precios" class="btn-warning"
                        invisible="not requiere_autorizacion_precio or state == 'cancel'"
                        help="Hay precios por debajo de la lista: un supervisor debe aprobarlos con su PIN."/>
            </xpath>
        </field>
    </record>
</odoo>
