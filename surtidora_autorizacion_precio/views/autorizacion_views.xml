<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_autorizacion_precio_list" model="ir.ui.view">
        <field name="name">surtidora.autorizacion.precio.list</field>
        <field name="model">surtidora.autorizacion.precio</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" delete="false">
                <field name="create_date" string="Fecha"/>
                <field name="tipo" decoration-danger="tipo == 'rb08'"/>
                <field name="estado_venta"
                       decoration-danger="estado_venta in ('cancelada', 'sin_venta')"/>
                <field name="order_ref"/>
                <field name="partner_id"/>
                <field name="product_id"/>
                <field name="uom_id"/>
                <field name="cantidad"/>
                <field name="precio_lista"/>
                <field name="precio_autorizado"/>
                <field name="solicitante_id"/>
                <field name="autorizador_id"/>
                <field name="costo" optional="show"/>
                <field name="motivo_texto" string="Motivo"/>
                <field name="motivo_id" optional="hide" string="Motivo (catálogo)"/>
                <field name="origen" optional="show"/>
                <field name="pos_order_id" optional="hide"/>
                <field name="nota" optional="hide"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Sin esto la barra de búsqueda solo entiende números de registro:
         Odoo genera un search por defecto con el id, así que buscar "Adelso"
         no devolvía nada. Es la pantalla con la que se va a auditar. -->
    <!-- Sin esto la barra de búsqueda solo entiende números de registro:
         Odoo genera un search por defecto con el id, así que buscar "Adelso"
         no devolvía nada. Es la pantalla con la que se va a auditar.
         OJO: el <group> del "Agrupar por" va SIN atributos — el validador de
         Odoo 19 rechaza expand y string ahí (ya nos pasó con otra vista). -->
    <record id="view_autorizacion_precio_search" model="ir.ui.view">
        <field name="name">surtidora.autorizacion.precio.search</field>
        <field name="model">surtidora.autorizacion.precio</field>
        <field name="arch" type="xml">
            <search string="Autorizaciones de precio">
                <field name="autorizador_id" string="Autorizó"/>
                <field name="solicitante_id" string="Pidió"/>
                <field name="product_id"/>
                <field name="partner_id"/>
                <field name="order_ref"/>
                <field name="motivo_texto" string="Motivo"/>
                <filter name="hoy" string="Hoy"
                        domain="[('create_date', '&gt;=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="mes" string="Este mes"
                        domain="[('create_date', '&gt;=', (context_today() + relativedelta(day=1)).strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter name="bajo_costo" string="BAJO COSTO" domain="[('tipo', '=', 'rb08')]"/>
                <filter name="bajo_lista" string="Bajo lista" domain="[('tipo', '=', 'rb01')]"/>
                <separator/>
                <filter name="sin_cobrar" string="Venta cancelada o inexistente"
                        domain="[('estado_venta', 'in', ['cancelada', 'sin_venta'])]"/>
                <separator/>
                <filter name="del_pos" string="Mostrador" domain="[('origen', '=', 'pos')]"/>
                <filter name="del_backend" string="Cotización" domain="[('origen', '=', 'backend')]"/>
                <group>
                    <filter name="g_autorizador" string="Autorizó"
                            context="{'group_by': 'autorizador_id'}"/>
                    <filter name="g_solicitante" string="Pidió"
                            context="{'group_by': 'solicitante_id'}"/>
                    <filter name="g_motivo" string="Motivo"
                            context="{'group_by': 'motivo_id'}"/>
                    <filter name="g_producto" string="Producto"
                            context="{'group_by': 'product_id'}"/>
                    <filter name="g_cliente" string="Cliente"
                            context="{'group_by': 'partner_id'}"/>
                    <filter name="g_tipo" string="Regla"
                            context="{'group_by': 'tipo'}"/>
                    <filter name="g_mes" string="Mes"
                            context="{'group_by': 'create_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_autorizacion_precio" model="ir.actions.act_window">
        <field name="name">Autorizaciones de precio</field>
        <field name="res_model">surtidora.autorizacion.precio</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="view_autorizacion_precio_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Sin autorizaciones registradas</p>
            <p>Aquí queda la auditoría de cada rebaja de precio aprobada con PIN de supervisor.</p>
        </field>
    </record>

    <menuitem id="menu_autorizacion_precio"
              name="Autorizaciones de precio"
              parent="sale.sale_menu_root"
              action="action_autorizacion_precio"
              groups="sales_team.group_sale_manager,surtidora_autorizacion_precio.group_autorizador_precio"
              sequence="90"/>

    <!-- Catálogo de motivos (punto 6): lista editable para gerencia -->
    <record id="view_motivo_descuento_list" model="ir.ui.view">
        <field name="name">surtidora.motivo.descuento.list</field>
        <field name="model">surtidora.motivo.descuento</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="action_motivo_descuento" model="ir.actions.act_window">
        <field name="name">Motivos de descuento</field>
        <field name="res_model">surtidora.motivo.descuento</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Sin motivos configurados</p>
            <p>Los motivos que el cajero/vendedor elige al autorizar un descuento
               o una venta bajo costo. Se eligen de esta lista para poder analizar
               cuáles generan más descuentos.</p>
        </field>
    </record>

    <menuitem id="menu_motivo_descuento"
              name="Motivos de descuento"
              parent="sale.sale_menu_root"
              action="action_motivo_descuento"
              groups="sales_team.group_sale_manager"
              sequence="91"/>
</odoo>
