<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <!-- RA: todos los campos numéricos son type="text" con inputmode: con
         type="number" el navegador rechaza el valor intermedio "48." y
         borraba el punto decimal mientras se tecleaba. -->
    <t t-name="surtidora_producto_alta.Pantalla">
        <div class="surti-alta o_content p-3">
            <div t-if="state.cargando" class="text-muted">Cargando…</div>
            <div t-elif="state.error" class="alert alert-danger">
                <t t-esc="state.error"/>
            </div>

            <t t-else="">
                <div class="d-flex align-items-center mb-3">
                    <h2 class="mb-0 me-auto">Alta de producto</h2>
                    <button class="btn btn-primary" t-on-click="crear"
                            t-att-disabled="state.guardando">
                        <t t-if="state.guardando">Creando…</t>
                        <t t-else="">Crear producto</t>
                    </button>
                </div>

                <div t-if="state.creado" class="alert alert-success py-2">
                    Creado <strong t-esc="state.creado.nombre"/>
                    <span t-if="state.creado.referencia">
                        [<t t-esc="state.creado.referencia"/>]
                    </span>
                    (<t t-esc="state.creado.empaques"/> empaque(s),
                    <t t-esc="state.creado.reglas"/> reglas de precio).
                    Se conservaron proveedor, categoría y unidad para el siguiente.
                </div>

                <!-- ── Identidad ────────────────────────────────────── -->
                <div class="surti-bloque">
                    <h5>Identidad</h5>
                    <div class="row g-2">
                        <div class="col-md-2">
                            <label class="surti-et">Referencia</label>
                            <input type="text" class="form-control form-control-sm"
                                   t-model="state.form.referencia"/>
                        </div>
                        <div class="col-md-4">
                            <label class="surti-et">Nombre del producto</label>
                            <input type="text" class="form-control form-control-sm"
                                   t-model="state.form.nombre"/>
                        </div>
                        <div class="col-md-3">
                            <label class="surti-et">Código de barras</label>
                            <div class="input-group input-group-sm">
                                <input type="text" class="form-control"
                                       t-model="state.form.barcode"/>
                                <button class="btn btn-outline-secondary"
                                        title="Generar código interno"
                                        t-on-click="() => this.generarCodigo(null)">Generar</button>
                            </div>
                        </div>
                        <div class="col-md-3 position-relative">
                            <label class="surti-et">Categoría</label>
                            <input type="text" class="form-control form-control-sm"
                                   t-att-value="state.form.categoria_nombre"
                                   t-on-input="(ev) => this.buscar('categoria', 'product.category', ev)"
                                   t-on-keydown="(ev) => this.teclas(ev, (f) => this.elegir('categoria', f))"
                                   t-on-blur="cerrarSugerencias"/>
                            <div t-if="state.campoActivo === 'categoria'" class="surti-sugerencias">
                                <div t-foreach="state.sugerencias" t-as="fila" t-key="fila.id"
                                     t-att-class="'surti-sug' + (fila_index === state.resaltado ? ' surti-sug-on' : '')"
                                     t-on-click="() => this.elegir('categoria', fila)">
                                    <t t-esc="fila.nombre"/>
                                </div>
                                <div t-if="!state.sugerencias.length and state.form.categoria_nombre"
                                     class="surti-sug surti-crear"
                                     t-on-click="() => this.crearRegistro('categoria', 'product.category')">
                                    + Crear categoría "<t t-esc="state.form.categoria_nombre"/>"
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4 position-relative">
                            <label class="surti-et">Proveedor</label>
                            <input type="text" class="form-control form-control-sm"
                                   t-att-value="state.form.proveedor_nombre"
                                   t-on-input="(ev) => this.buscar('proveedor', 'res.partner', ev)"
                                   t-on-keydown="(ev) => this.teclas(ev, (f) => this.elegir('proveedor', f))"
                                   t-on-blur="cerrarSugerencias"/>
                            <div t-if="state.campoActivo === 'proveedor'" class="surti-sugerencias">
                                <div t-foreach="state.sugerencias" t-as="fila" t-key="fila.id"
                                     t-att-class="'surti-sug' + (fila_index === state.resaltado ? ' surti-sug-on' : '')"
                                     t-on-click="() => this.elegir('proveedor', fila)">
                                    <t t-esc="fila.nombre"/>
                                </div>
                                <div t-if="!state.sugerencias.length and state.form.proveedor_nombre"
                                     class="surti-sug surti-crear"
                                     t-on-click="() => this.crearRegistro('proveedor', 'res.partner')">
                                    + Crear proveedor "<t t-esc="state.form.proveedor_nombre"/>"
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <label class="surti-et">Código del proveedor</label>
                            <input type="text" class="form-control form-control-sm"
                                   t-model="state.form.ref_proveedor"/>
                        </div>
                    </div>
                </div>

                <!-- ── Unidad y costo ───────────────────────────────── -->
                <div class="surti-bloque">
                    <h5>Unidad base y costo</h5>
                    <div class="row g-2 align-items-end">
                        <div class="col-md-3 position-relative">
                            <label class="surti-et">Unidad base (la que se vende suelta)</label>
                            <input type="text" class="form-control form-control-sm"
                                   t-att-value="state.form.uom_nombre"
                                   t-on-input="buscarBase"
                                   t-on-keydown="(ev) => this.teclas(ev, (f) => this.elegir('uom', f))"
                                   t-on-blur="cerrarSugerencias"/>
                            <div t-if="state.campoActivo === 'uom'" class="surti-sugerencias">
                                <div t-foreach="state.sugerencias" t-as="fila" t-key="fila.id"
                                     t-att-class="'surti-sug' + (fila_index === state.resaltado ? ' surti-sug-on' : '')"
                                     t-on-click="() => this.elegir('uom', fila)">
                                    <t t-esc="fila.nombre"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-2">
                            <label class="surti-et">Costo SIN ITBIS</label>
                            <input type="text" inputmode="decimal"
                                   class="form-control form-control-sm"
                                   t-model="state.form.costo"/>
                        </div>
                        <div class="col-md-2">
                            <label class="surti-et">El costo es por</label>
                            <select class="form-select form-select-sm"
                                    t-model="state.form.costo_por">
                                <option value="base">Unidad base</option>
                                <t t-foreach="empaquesValidos" t-as="emp" t-key="emp.uom_id">
                                    <option t-att-value="emp.uom_id" t-esc="emp.uom_nombre"/>
                                </t>
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label class="surti-et">Costo unidad c/ITBIS</label>
                            <div class="surti-vl" t-esc="n(costoConItbis)"/>
                        </div>
                        <div class="col-md-3" t-if="state.config.impuesto">
                            <div class="form-check">
                                <input type="checkbox" class="form-check-input"
                                       t-att-checked="state.form.impuesto_id"
                                       t-on-change="(ev) => state.form.impuesto_id = ev.target.checked ? state.config.impuesto.id : null"/>
                                <label class="form-check-label small"
                                       t-esc="state.config.impuesto.nombre"/>
                            </div>
                            <div class="form-check">
                                <input type="checkbox" class="form-check-input"
                                       t-model="state.form.fraccionable"/>
                                <label class="form-check-label small">
                                    La caja se puede fraccionar (¼ ½ ¾)
                                </label>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- ── Empaques ─────────────────────────────────────── -->
                <div class="surti-bloque">
                    <div class="d-flex align-items-center">
                        <h5 class="me-auto mb-0">Otras unidades (empaques)</h5>
                        <button class="btn btn-sm btn-outline-primary"
                                t-on-click="agregarEmpaque">Agregar empaque</button>
                    </div>
                    <table class="table table-sm mt-2 mb-0" t-if="state.form.empaques.length">
                        <thead>
                            <tr>
                                <th style="width: 34%;">Unidad</th>
                                <th class="text-end" style="width: 10%;">Factor</th>
                                <th style="width: 28%;">Código de barras</th>
                                <th class="text-center" style="width: 14%;">De compra</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="state.form.empaques" t-as="empaque" t-key="empaque._key">
                                <td class="position-relative">
                                    <input type="text" class="form-control form-control-sm"
                                           placeholder="Ej: Caja de 24"
                                           t-att-value="empaque.uom_nombre"
                                           t-on-input="(ev) => this.buscarUom(empaque_index, ev)"
                                           t-on-keydown="(ev) => this.teclas(ev, (f) => this.elegirUom(empaque_index, f))"
                                           t-on-blur="cerrarSugerencias"/>
                                    <div t-if="state.campoActivo === 'emp' + empaque_index"
                                         class="surti-sugerencias">
                                        <div t-foreach="state.sugerencias" t-as="fila" t-key="fila.id"
                                             t-att-class="'surti-sug' + (fila_index === state.resaltado ? ' surti-sug-on' : '')"
                                             t-on-click="() => this.elegirUom(empaque_index, fila)">
                                            <t t-esc="fila.nombre"/>
                                            <span class="text-muted small">
                                                — <t t-esc="n(fila.factor, 0)"/> unidades base
                                            </span>
                                        </div>
                                        <!-- RA: crear la unidad que falta sin salir -->
                                        <div t-if="!state.sugerencias.length and empaque.uom_nombre"
                                             class="surti-sug surti-crear">
                                            <div class="mb-1">
                                                + Crear "<t t-esc="empaque.uom_nombre"/>"
                                            </div>
                                            <div class="input-group input-group-sm">
                                                <input type="text" inputmode="numeric"
                                                       class="form-control"
                                                       placeholder="¿cuántas unidades base?"
                                                       t-model="empaque.factor_nuevo"
                                                       t-on-mousedown.stop=""/>
                                                <button class="btn btn-primary"
                                                        t-on-click.stop="() => this.crearUnidad(empaque_index)">
                                                    Crear
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                                <td class="text-end surti-vl">
                                    <t t-if="empaque.factor" t-esc="n(empaque.factor, 0)"/>
                                    <t t-else="">—</t>
                                </td>
                                <td>
                                    <div class="input-group input-group-sm">
                                        <input type="text" class="form-control"
                                               t-model="empaque.barcode"/>
                                        <button class="btn btn-outline-secondary"
                                                t-on-click="() => this.generarCodigo(empaque_index)">
                                            Generar
                                        </button>
                                    </div>
                                </td>
                                <td class="text-center">
                                    <input type="radio" class="form-check-input"
                                           t-att-checked="state.form.uom_compra_id === empaque.uom_id"
                                           t-att-disabled="!empaque.uom_id"
                                           t-on-change="() => state.form.uom_compra_id = empaque.uom_id"/>
                                </td>
                                <td class="text-end">
                                    <button class="btn btn-sm btn-link text-danger"
                                            t-on-click="() => this.quitarEmpaque(empaque_index)">
                                        Quitar
                                    </button>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                    <p t-else="" class="text-muted small mb-0">
                        Sin empaques: el producto solo se vende en su unidad base.
                    </p>
                </div>

                <!-- ── Precios ──────────────────────────────────────── -->
                <div class="surti-bloque">
                    <div class="d-flex align-items-end mb-2">
                        <h5 class="me-auto mb-0">Precios (con ITBIS incluido)</h5>
                        <div class="me-2">
                            <label class="surti-et">Margen objetivo % (detalle)</label>
                            <input type="text" inputmode="decimal"
                                   class="form-control form-control-sm"
                                   style="width: 110px;" t-model="state.form.margen_objetivo"/>
                        </div>
                        <button class="btn btn-sm btn-outline-primary"
                                t-on-click="sugerirPrecios">Sugerir precios</button>
                    </div>
                    <table class="table table-sm mb-0">
                        <thead>
                            <tr>
                                <th>Lista</th>
                                <th class="text-end">Precio unidad</th>
                                <th class="text-end">Margen</th>
                                <t t-foreach="empaquesValidos" t-as="empaque" t-key="empaque._key">
                                    <th class="text-end"><t t-esc="empaque.uom_nombre"/> completo</th>
                                    <th class="text-end">Margen</th>
                                </t>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="state.config.listas" t-as="lista" t-key="lista.id">
                                <td t-esc="lista.nombre"/>
                                <td class="text-end">
                                    <input type="text" inputmode="decimal"
                                           class="form-control form-control-sm text-end"
                                           t-att-value="precio(lista, null)"
                                           t-on-input="(ev) => this.escribirPrecio(lista, null, ev)"/>
                                </td>
                                <td t-att-class="'text-end surti-vl ' + claseMargen(lista, null)">
                                    <t t-if="margen(lista, null) !== null">
                                        <t t-esc="n(margen(lista, null), 1)"/>%
                                    </t>
                                    <t t-else="">—</t>
                                </td>
                                <t t-foreach="empaquesValidos" t-as="empaque" t-key="empaque._key">
                                    <td class="text-end">
                                        <input type="text" inputmode="decimal"
                                               class="form-control form-control-sm text-end"
                                               t-att-value="precio(lista, empaque)"
                                               t-on-input="(ev) => this.escribirPrecio(lista, empaque, ev)"/>
                                    </td>
                                    <td t-att-class="'text-end surti-vl ' + claseMargen(lista, empaque)">
                                        <t t-if="margen(lista, empaque) !== null">
                                            <t t-esc="n(margen(lista, empaque), 1)"/>%
                                        </t>
                                        <t t-else="">—</t>
                                    </td>
                                </t>
                            </tr>
                        </tbody>
                    </table>
                    <p class="text-muted small mb-0 mt-1">
                        El precio del empaque es el de la caja COMPLETA. Ningún precio
                        puede quedar por debajo del costo (regla RB-08).
                    </p>
                </div>

                <!-- ── Reorden ──────────────────────────────────────── -->
                <div class="surti-bloque">
                    <h5>Reorden</h5>
                    <div class="row g-2">
                        <div class="col-md-2">
                            <label class="surti-et">Mínimo</label>
                            <input type="text" inputmode="numeric"
                                   class="form-control form-control-sm"
                                   t-model="state.form.reorden_min"/>
                        </div>
                        <div class="col-md-2">
                            <label class="surti-et">Máximo</label>
                            <input type="text" inputmode="numeric"
                                   class="form-control form-control-sm"
                                   t-model="state.form.reorden_max"/>
                        </div>
                        <div class="col-md-4" t-if="state.config.almacen">
                            <label class="surti-et">Almacén</label>
                            <div class="surti-vl" t-esc="state.config.almacen.nombre"/>
                        </div>
                    </div>
                </div>
            </t>
        </div>
    </t>
</templates>
