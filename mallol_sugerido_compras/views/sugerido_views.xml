<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_sugerido_form" model="ir.ui.view">
        <field name="model">mallol.sugerido.compras</field>
        <field name="arch" type="xml">
            <form string="Sugerido de Compras por Rotación de Ventas">
                <sheet>
                    <div class="oe_title">
                        <h2>Sugerido de Compras por Rotación de Ventas</h2>
                    </div>
                    <group>
                        <group>
                            <field name="supplier_id" />
                        </group>
                        <group>
                            <field name="dias_abastecer" />
                            <field name="dias_historial" />
                        </group>
                    </group>
                    <button name="action_calcular" type="object"
                        string="Calcular sugerido" class="btn-primary" />
                    <field name="line_ids" nolabel="1" class="mt-2">
                        <list editable="bottom" create="0" delete="0"
                            default_order="cant_sugerida desc">
                            <field name="default_code" />
                            <field name="product_id" readonly="1" />
                            <field name="uom_name" />
                            <field name="existencia_actual" readonly="1" />
                            <field name="ventas_dia" readonly="1" />
                            <field name="cant_necesaria" readonly="1" />
                            <field name="ordenes_pendientes" readonly="1" />
                            <field name="cant_sugerida" readonly="1"
                                decoration-danger="cant_sugerida &lt; 0"
                                decoration-success="cant_sugerida &gt; 0" />
                            <field name="cantidad_ordenar" />
                        </list>
                    </field>
                </sheet>
                <footer>
                    <button name="action_generar_oc" type="object"
                        string="Generar Orden de Compra" class="btn-primary" />
                    <button string="Cerrar" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_sugerido" model="ir.actions.act_window">
        <field name="name">Sugerido de Compras</field>
        <field name="res_model">mallol.sugerido.compras</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>

    <menuitem id="menu_sugerido_root" name="Sugerido de Compras"
        parent="purchase.menu_purchase_root"
        action="action_sugerido" sequence="15"
        groups="purchase.group_purchase_user" />
</odoo>
