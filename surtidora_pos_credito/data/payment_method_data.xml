<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Sin diario contable el método es tipo "pay_later": el monto queda en
         la cuenta por cobrar del cliente en vez de entrar a caja.
         split_transactions = un apunte por cliente (no un consolidado). -->
    <record id="metodo_pago_credito" model="pos.payment.method">
        <field name="name">Crédito (Cuenta Cliente)</field>
        <field name="split_transactions" eval="True"/>
    </record>

    <!-- REQ-V18 / política 12.4: el bono por devolución vive como nota de
         crédito abierta del cliente y se APLICA como crédito en la compra
         nueva (pago mixto). También pay_later + split: al cierre de sesión
         genera el apunte por cliente que CxC concilia contra la NC. -->
    <record id="metodo_pago_bono" model="pos.payment.method">
        <field name="name">Bono / Nota de Crédito</field>
        <field name="split_transactions" eval="True"/>
        <field name="surtidora_es_bono" eval="True"/>
    </record>
</odoo>
