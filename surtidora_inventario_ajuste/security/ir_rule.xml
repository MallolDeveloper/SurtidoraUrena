<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- La bitácora de una compañía no se ve desde otra. -->
    <record id="rule_bitacora_company" model="ir.rule">
        <field name="name">Bitácora de ajustes: multi-compañía</field>
        <field name="model_id" ref="model_surtidora_ajuste_bitacora"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>
</odoo>
