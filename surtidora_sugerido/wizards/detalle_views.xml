<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sugerido_detalle_form" model="ir.ui.view">
        <field name="name">surtidora.sugerido.detalle.form</field>
        <field name="model">surtidora.sugerido.detalle</field>
        <field name="arch" type="xml">
            <form string="Información del producto">
                <group>
                    <group string="Producto">
                        <field name="product_id" readonly="1"/>
                        <field name="uom_base_name"/>
                        <field name="existencia_actual"/>
                        <field name="dias_desde_compra"/>
                    </group>
                    <group string="Costos (sin ITBIS)">
                        <field name="ultimo_costo_base"/>
                        <field name="costo_promedio"/>
                        <field name="dev_ventas"/>
                        <field name="dev_compras"/>
                    </group>
                </group>
                <notebook>
                    <page string="Compras vs ventas por mes" name="matriz">
                        <field name="mes_ids" nolabel="1">
                            <list create="0" delete="0">
                                <field name="mes"/>
                                <field name="comprado"/>
                                <field name="vendido"
                                       decoration-warning="vendido &gt; comprado"/>
                            </list>
                        </field>
                    </page>
                    <page string="Últimas compras (todos los suplidores)" name="compras">
                        <field name="compra_ids" nolabel="1">
                            <list create="0" delete="0">
                                <field name="fecha"/>
                                <field name="cantidad"/>
                                <field name="unidad"/>
                                <field name="costo"/>
                                <field name="suplidor"/>
                                <field name="orden" optional="hide"/>
                            </list>
                        </field>
                    </page>
                    <page string="OC pendientes" name="ocs">
                        <field name="oc_ids" nolabel="1">
                            <list create="0" delete="0">
                                <field name="orden"/>
                                <field name="fecha"/>
                                <field name="suplidor"/>
                                <field name="ordenada"/>
                                <field name="pendiente"/>
                                <field name="unidad"/>
                            </list>
                        </field>
                    </page>
                </notebook>
                <footer>
                    <button string="Cerrar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
