<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Las variantes, junto al nombre de la etiqueta -->
    <record id="view_partner_category_form_surtidora" model="ir.ui.view">
        <field name="name">res.partner.category.form.surtidora</field>
        <field name="model">res.partner.category</field>
        <field name="inherit_id" ref="base.view_partner_category_form"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="surtidora_variantes"
                       placeholder="CHUCHERO, CHUCHERA, CHUCHERIA"/>
            </field>
        </field>
    </record>

    <record id="view_partner_category_list_surtidora" model="ir.ui.view">
        <field name="name">res.partner.category.list.surtidora</field>
        <field name="model">res.partner.category</field>
        <field name="inherit_id" ref="base.view_partner_category_list"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="surtidora_variantes" optional="show"/>
            </field>
        </field>
    </record>

    <!-- Asistente -->
    <record id="view_extraer_categoria_form" model="ir.ui.view">
        <field name="name">surtidora.extraer.categoria.form</field>
        <field name="model">surtidora.extraer.categoria</field>
        <field name="arch" type="xml">
            <form string="Clasificar clientes por su categoría">
                <div class="alert alert-info" role="alert">
                    En el sistema actual la categoría del cliente vive dentro
                    del nombre, entre paréntesis. Esto la convierte en una
                    etiqueta buscable y limpia el nombre.
                    Solo se tocan los clientes cuyo paréntesis coincide con
                    una categoría conocida: los apodos y nombres de dueños se
                    dejan como están.
                </div>
                <group>
                    <field name="aplicar_nombre"/>
                    <field name="solo_sin_etiqueta"/>
                    <field name="revisado" invisible="1"/>
                </group>
                <separator string="Vista previa" invisible="not revisado"/>
                <field name="vista_previa" nolabel="1" readonly="1"
                       invisible="not revisado"/>
                <footer>
                    <button string="Ver qué va a pasar" name="action_vista_previa"
                            type="object" class="btn-primary"/>
                    <button string="Aplicar" name="action_aplicar" type="object"
                            class="btn-primary" invisible="not revisado"
                            confirm="Se van a etiquetar los clientes y, si lo pidió, se limpiará su nombre. ¿Continuar?"/>
                    <button string="Cerrar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_extraer_categoria" model="ir.actions.act_window">
        <field name="name">Clasificar clientes por categoría</field>
        <field name="res_model">surtidora.extraer.categoria</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_extraer_categoria"
              name="Clasificar clientes por categoría"
              parent="sale.menu_sale_config"
              action="action_extraer_categoria"
              groups="sales_team.group_sale_manager"
              sequence="95"/>
</odoo>
