<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_template_fraccionable" model="ir.ui.view">
        <field name="name">product.template.form.caja.fraccionable</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='categ_id']" position="after">
                <field name="surtidora_caja_fraccionable"/>
                <field name="surtidora_aviso_fraccion" invisible="1"/>
                <div class="alert alert-warning" role="alert" colspan="2"
                     invisible="not surtidora_aviso_fraccion">
                    <field name="surtidora_aviso_fraccion" nolabel="1" readonly="1"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
