<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_negociacion_wizard_form" model="ir.ui.view">
        <field name="name">surtidora.negociacion.wizard.form</field>
        <field name="model">surtidora.negociacion.wizard</field>
        <field name="arch" type="xml">
            <form string="Negociación">
                <group>
                    <field name="product_id" readonly="1"/>
                    <field name="partner_id" readonly="1"/>
                </group>
                <notebook>
                    <page string="Precios por empaque" name="precios">
                        <field name="precio_ids" nolabel="1">
                            <list create="false" delete="false" editable="bottom">
                                <field name="es_actual" string="✓" widget="boolean" readonly="1"/>
                                <field name="uom_id"/>
                                <field name="factor"/>
                                <field name="precio"/>
                                <field name="equivalente_base"/>
                                <field name="currency_id" column_invisible="1"/>
                                <button name="action_usar" type="object" string="Usar" class="btn-primary"
                                        title="Cambiar la línea a este empaque"/>
                            </list>
                        </field>
                    </page>
                    <page string="Existencia por almacén" name="stock">
                        <field name="stock_ids" nolabel="1">
                            <list create="false" delete="false">
                                <field name="warehouse_id"/>
                                <field name="existencia"/>
                                <field name="reservada"/>
                                <field name="disponible"/>
                                <field name="uom_id"/>
                            </list>
                        </field>
                    </page>
                    <page string="Últimas compras del cliente" name="historial">
                        <field name="historial_ids" nolabel="1">
                            <list create="false" delete="false">
                                <field name="fecha"/>
                                <field name="orden"/>
                                <field name="cantidad"/>
                                <field name="uom_id"/>
                                <field name="precio"/>
                                <field name="currency_id" column_invisible="1"/>
                            </list>
                        </field>
                    </page>
                </notebook>
                <footer>
                    <button string="Cerrar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
