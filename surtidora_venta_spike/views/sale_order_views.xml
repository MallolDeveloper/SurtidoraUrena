<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_negociacion" model="ir.ui.view">
        <field name="name">sale.order.form.negociacion.spike</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list/field[@name='price_unit']" position="after">
                <button name="action_abrir_negociacion" type="object" icon="fa-handshake-o"
                        title="Negociación: precios por empaque, existencia e historial del cliente"
                        invisible="display_type or not product_id"/>
            </xpath>
        </field>
    </record>
</odoo>
